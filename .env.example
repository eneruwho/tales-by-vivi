# Copy this file to `.env.local` and fill real values. Do NOT commit `.env.local`.
# Example environment variables for this project.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudinary (use the CLOUDINARY_URL format or separate parts)
# Example: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=

# Mailgun
MAILGUN_API_KEY=
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_DOMAIN=
MAILGUN_FROM=

# Mailgun OTP settings
OTP_TTL_SECONDS=60
OTP_RESEND_LIMIT=5

# Other (adjust as needed)
NEXT_PUBLIC_APP_URL=
DAILY_MAILGUN_LIMIT=100
ADMIN_EMAIL=
ADMIN_PASSWORD=
